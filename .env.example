# Copy to .env. The file is not committed. Secrets are read from the environment only.

PORT=8080
DATA_PATH=./data
LOG_LEVEL=info
PUBLIC_MODEL=coffee-opencode-llm
PROXY=0

# Modes: client_first | strict_min, balanced | quality | price,
# min | medium | high | max, free | go | go-plus | go-teams.
# Reasoning: reasoning_context_enabled is the master switch,
# assistant2_reasoning_enabled gates the helper alone.
OUTPUT_LIMIT_MODE=client_first
OBJECTIVE_MODE=balanced
REASONING_MODE=medium
REASONING_CONTEXT_ENABLED=0
ASSISTANT2_REASONING_ENABLED=1
SUBSCRIPTION_MODE=free

# One upstream: OpenCode inference. The URL names the free-tier endpoint;
# paid plans use its /go path.
OPENCODE_INFERENCE_URL=
OPENCODE_API_KEY=

# Free decision solver.
JEV_BASE_URL=
JEV_API_KEY=
ADJUSTER_JEV_MODEL=jev-latest

# Every key in config/gateway.yaml can be overridden by its upper-case name,
# for example MAX_REQUEST_BYTES or UPSTREAM_TIMEOUT_MS.
